#!/usr/bin/env bash

set -eu

### macOS settings ###

# Ensure `~/git` exists
mkdir -p ~/git

# Turn off the really annoying bouncing notification icons.
defaults write com.apple.dock no-bouncing -bool TRUE

### Brew essential packages ###

# Install GNU coreutils so they can be used on Mac
brew install coreutils
# Install ninja for building lua-language-server
brew install ninja
# Install gnupg for GPG key signing (git)
brew install gnupg
# Install bash completion for Bash... completion
brew install bash-completion
# Install pyenv for installing any Python version
brew install pyenv
# Install compression utils, which some libraries use
brew install xz
# Install tools for finding and filtering things
brew install rg fzf jq yq
# Install AWS CLI for working with AWS
brew install awscli
# Install NPM for getting access to all things Node/JS/TS
brew install npm
# Install Neovim for testing plugins in Neovim
brew install neovim
# Install go to install all other go things
brew install go
# Install shellcheck for linting shell scripts
brew install shellcheck
# Install poppler for `pdftotext`
brew install poppler
# Install `gh` for GitHub commands, with extensions
# Enables `gh codeowners lint`, `gh codeowners view`, `gh codeowners pr 123`
brew install gh && gh extension install heaths/gh-codeowners
# Install VSCode for helping other developers.
brew install --cask visual-studio-code
# Install k9s for kubernetes
brew install derailed/k9s/k9s

### Brew nice-to-have packages ###

# Install pandoc for converting HTML 2 PDF and so on
brew install pandoc
# Needed for HTML 2 PDF conversion
brew install --cask mactex

# Optional: Install monitorcontrol for setting up monitors.
# brew install --cask monitorcontrol

### Go setup ###

# Install a more recent version of Go than Brew has.
go_version=1.2.3
go install "golang.org/dl/go${go_version}@latest"
"go${go_version}" download


### Rust setup ###

# Press Enter to proceed with default installation
curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh

# Clone and build c2pastrip for removing c2pa data from AI images.
(
    cd ~/git
    git clone git@github.com:neon2048/c2pastrip.git
    cd c2pastrip
    # Check out a specific commit for security reasons.
    # NOTE: This will need adjusting over time.
    git checkout d18c646fc9e1612d6908b1a43f783974c61b58b3

    # The build fails without updating time, some of the time.
    cargo update -p time
    cargo build
    cargo build --release
    install target/release/c2pastrip ~/.cargo/bin/
)

### JS/TS setup ###
# NOTE: Review what has been installed with: npm list -g --depth=0

# Disable npm installation scripts
npm config set ignore-scripts true --location=user

### Python setup ###

# Add poetry for installing Python packages
pip install poetry

# FIXME: We'll need to fix Python installation to set up uv later.

# Install tombi for checking TOML files.
uv tool install tombi

### Go setup ###

# Install gopls for the Go language server
go install golang.org/x/tools/gopls@latest

# Install golangci-lint for pretty much all Go linting
go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest

### Other tools via language package managers ###

# Add a language server for VimL
npm install -g vim-language-server

# Install commitlint for commit message linting
npm install -g @commitlint/cli @commitlint/config-conventional

# Add a tool to fuzzy autofix JSON (underrated!)
npm install -g fixjson

# Install html2pdf for converting HTML to... PDFs...
npm install -g html2pdf.js

# Install mermaid CLI for converting mermaid diagrams to SVG/PNG
npm install -g @mermaid-js/mermaid-cli

# Add a tool for linting git commits
pip install gitlint

# Install Ghostty as the Terminal
brew install --cask ghostty

# Install the config that came with this script repo.
mkdir -p  ~/Library/Application\ Support/com.mitchellh.ghostty
cp ~/script/bootstrap/ghostty-config ~/Library/Application\ Support/com.mitchellh.ghostty/config

# Disable "last login" messages
touch ~/.hushlogin

# Make Ghostty the default command script application
# This makes Linear launch Claude Code CLI in Ghostty instead of Terminal.app
brew install duti
duti -s com.mitchellh.ghostty .command all

# Configure Claude Code
brew install --cask claude-code

if ! [ -d ~/.claude ]; then
    echo 'Cloning claude-code-config into ~/.claude ...'
    echo
    git clone git@github.com:w0rp/claude-code-config.git ~/.claude
fi

# Configure OpenCode
brew install anomalyco/tap/opencode

if ! [ -d ~/.config/opencode ]; then
    echo 'Cloning opencode-config into ~/.config/opencode ...'
    echo
    mkdir -p ~/.config
    git clone git@github.com:w0rp/opencode-config.git ~/.config/opencode
fi

# Install build dependencies for Zeal, including Qt
brew install qt@6
brew install libarchive
brew install vulkan-headers
brew install cmake

# Install Zeal by building it for Mac
(
    CMAKE_PREFIX_PATH="$(brew --prefix qt@6):$(brew --prefix libarchive):$(brew --prefix vulkan-headers)"
    export CMAKE_PREFIX_PATH

    cd ~/git
    git clone https://github.com/zealdocs/zeal.git
)

# Configure git delta to open file links with GVim through a handler.
configure_delta_gvim_links() {
    local app_dir="$HOME/Applications/GVimURLHandler.app"
    local script_dir="$HOME/.local/bin/"
    local handler_file="${script_dir}gvim-url-handler"

    mkdir -p "$script_dir"

    cat > "$handler_file" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

python3 - "$1" <<'PY' | "$HOME/script/unix/gvim"
import sys
import urllib.parse

url = urllib.parse.urlparse(sys.argv[1])
query = urllib.parse.parse_qs(url.query)

file_path = query.get('file', [''])[0]
line_number = query.get('line', [''])[0]

if file_path:
    if line_number:
        print(f'{file_path}::{line_number}')
    else:
        print(file_path)
PY
EOF

    chmod +x "$handler_file"

    osacompile -o "$app_dir" <<EOF
on open location this_url
    do shell script quoted form of "$handler_file" & " " & quoted form of this_url
end open location
EOF

    /usr/libexec/PlistBuddy -c 'Add :CFBundleURLTypes array' "$app_dir/Contents/Info.plist" 2>/dev/null || true
    /usr/libexec/PlistBuddy -c 'Add :CFBundleURLTypes:0 dict' "$app_dir/Contents/Info.plist" 2>/dev/null || true
    /usr/libexec/PlistBuddy -c 'Add :CFBundleURLTypes:0:CFBundleURLName string GVimURLHandler' "$app_dir/Contents/Info.plist" 2>/dev/null || true
    /usr/libexec/PlistBuddy -c 'Add :CFBundleURLTypes:0:CFBundleURLSchemes array' "$app_dir/Contents/Info.plist" 2>/dev/null || true
    /usr/libexec/PlistBuddy -c 'Add :CFBundleURLTypes:0:CFBundleURLSchemes:0 string gvim' "$app_dir/Contents/Info.plist" 2>/dev/null || true

    /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app_dir"

    git config --global delta.hyperlinks true
    git config --global delta.hyperlinks-file-link-format 'gvim://open?file={path}&line={line}'
}
configure_delta_gvim_links

echo 'Mac installation complete!'
echo
echo 'Now run: chsh -s /opt/homebrew/bin/bash'
